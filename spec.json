{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://manim-widget/schema/v2",
  "title": "ManimWidgetScene",
  "description": "Complete serialized Manim scene for client-side playback.",
  "type": "object",
  "required": [
    "version",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "fps": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "const": 2
    },
    "frame_width": {
      "type": "number",
      "description": "Scene frame width in Manim units (default 14.222)."
    },
    "frame_height": {
      "type": "number",
      "description": "Scene frame height in Manim units (default 8.0)."
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Section"
      }
    },
    "states": {
      "type": "array",
      "description": "Global state bank shared across all sections. Commands and snapshots reference entries by integer index.",
      "items": {
        "$ref": "#/definitions/MobjectState"
      }
    }
  },
  "definitions": {
    "Section": {
      "type": "object",
      "required": [
        "name",
        "snapshot",
        "construct"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "background_color": {
          "$ref": "#/definitions/Color"
        },
        "unsupported": {
          "type": "boolean",
          "description": "If true, this section cannot be played back. JS must show a warning."
        },
        "unsupported_reason": {
          "type": "string",
          "description": "Human-readable explanation of why the section is unsupported."
        },
        "snapshot": {
          "oneOf": [
            {
              "$ref": "#/definitions/Snapshot"
            },
            {
              "type": "null"
            }
          ],
          "description": "Full scene state at section entry. Null only when unsupported=true. Maps mob_id to state_ref index into the global states bank."
        },
        "construct": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Command"
          },
          "description": "Ordered list of commands to execute. Empty when unsupported=true."
        }
      }
    },
    "Snapshot": {
      "type": "object",
      "description": "Scene state at the start of this section. Maps object_id -> index in the global states bank. The special '#camera' key maps to a CameraState ref. Group children are NOT listed separately — referenced via GroupState.children.",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "MobjectState": {
      "description": "State variant holding geometrical or textual data. Nature of data is determined by the 'kind' field: 'VMobject', 'Group', 'MathTexSource', 'ImageMobject', 'PMobject', 'Camera', or 'Derived'. A 'Derived' entry inherits all fields from a parent state and overrides specific fields; its 'from' index must be less than its own index.",
      "oneOf": [
        {
          "$ref": "#/definitions/VMobjectState"
        },
        {
          "$ref": "#/definitions/GroupState"
        },
        {
          "$ref": "#/definitions/MathTexSourceState"
        },
        {
          "$ref": "#/definitions/ImageMobjectState"
        },
        {
          "$ref": "#/definitions/ValueTrackerState"
        },
        {
          "$ref": "#/definitions/PMobjectState"
        },
        {
          "$ref": "#/definitions/CameraState"
        },
        {
          "$ref": "#/definitions/DerivedState"
        }
      ]
    },
    "DerivedState": {
      "type": "object",
      "description": "Derived entry: inherits all fields from the parent state at index 'from', then overrides with its own fields. The 'from' index must be strictly less than this entry's own index. Used for ImageMobject to separate pixel data (parent) from positional data (child), and for updater frame delta compression.",
      "required": [
        "kind",
        "from"
      ],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["Derived"]
        },
        "from": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the global states bank of the parent entry whose fields are inherited. Must be less than this entry's own index."
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "description": "Corner positions in scene coordinates [UL, UR, DL, DR]. Used for ImageMobject placement overrides."
        }
      }
    },
    "VMobjectState": {
      "type": "object",
      "required": [
        "kind",
        "contours"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "VMobject",
          "description": "Generic VMobject state with bezier contours."
        },
        "contours": {
          "type": "array",
          "description": "Outer filled regions. Each contour is a closed bezier path with 3n+1 points: [p0, h0_a, h0_b, p1, ...] where pi are anchors and hi_a/hi_b are handles. Empty array means no geometry.",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "holes": {
          "type": "array",
          "description": "Cutout regions subtracted from the filled contours (e.g. the inside of 'O', 'B', or Difference). Same point format as contours.",
          "items": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 3,
              "maxItems": 3
            }
          }
        },
        "fill_color": {
          "$ref": "#/definitions/Color"
        },
        "fill_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stroke_color": {
          "$ref": "#/definitions/Color"
        },
        "stroke_width": {
          "type": "number",
          "minimum": 0
        },
        "stroke_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "z_index": {
          "type": "number"
        },
        "text": {
          "type": "string",
          "description": "Text content for Text/MarkupText mobjects."
        },
        "font_size": {
          "type": "number",
          "description": "Font size for Text/MarkupText mobjects."
        }
      }
    },
    "GroupState": {
      "type": "object",
      "required": [
        "kind",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Group",
            "Arrow"
          ],
          "description": "Group of child mobjects. Arrow kind: points is the shaft VMobject, children[0] is the tip VMobject."
        },
        "children": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Ordered list of child state_refs. Resolved through the global states bank to create child mobjects. Group children are NOT in the snapshot - only the Group root is."
        },
        "z_index": {
          "type": "number"
        }
      }
    },
    "MathTexSourceState": {
      "type": "object",
      "required": [
        "kind",
        "latex",
        "points"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "MathTexSource",
          "description": "LaTeX math expression rendered client-side."
        },
        "latex": {
          "type": "string",
          "description": "Raw LaTeX string. Rendered client-side."
        },
        "points": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "Signed corners [top_left, top_right, bottom_right, bottom_left]. Base corners are [LEFT+UP, RIGHT+UP, RIGHT+DOWN, LEFT+DOWN] scaled by (font_size/48). Player computes center as midpoint(top_left, bottom_right), rightVec=(top_right-top_left)/2, upVec=(top_left-bottom_left)/2."
        },
        "stroke_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color": {
          "$ref": "#/definitions/Color"
        },
        "z_index": {
          "type": "number"
        }
      }
    },
    "ImageMobjectState": {
      "type": "object",
      "required": [
        "kind",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "ImageMobject"
        },
        "source": {
          "type": "string",
          "description": "Image source URL. Typically a data URI (data:image/png;base64,...)."
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "description": "Image corners in scene coordinates ordered as [UL, UR, DL, DR]."
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "z_index": {
          "type": "number"
        }
      }
    },
    "ValueTrackerState": {
      "type": "object",
      "required": [
        "value",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "ValueTracker"
        },
        "value": {
          "type": "number",
          "description": "Current tracked value. Not rendered; used by updater-driven animations."
        }
      }
    },
    "PMobjectState": {
      "type": "object",
      "description": "A point cloud rendered as particles (PMobject leaf, e.g. Point, PointCloudDot). Carries the full list of points; rendered as a single particle buffer. A single Point is just this with one entry.",
      "required": [
        "kind",
        "points"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "PMobject"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Vec3"
          },
          "description": "Point positions [x, y, z] in scene coordinates, one per particle."
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Color"
          },
          "description": "Per-point colors, parallel to 'points'."
        },
        "opacities": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Per-point opacities, parallel to 'points'."
        }
      }
    },
    "Command": {
      "oneOf": [
        {
          "$ref": "#/definitions/RegisterCommand"
        },
        {
          "$ref": "#/definitions/RemoveCommand"
        },
        {
          "$ref": "#/definitions/RebindCommand"
        },
        {
          "$ref": "#/definitions/AnimateCommand"
        },
        {
          "$ref": "#/definitions/UpdaterDescriptor"
        },
        {
          "$ref": "#/definitions/MoveCameraCommand"
        }
      ]
    },
    "RegisterCommand": {
      "type": "object",
      "description": "Bind or update a mobject in the JS scene graph by mapping id to a section-local state_ref, and add it to the visible scene.",
      "required": [
        "cmd",
        "id",
        "state_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "type": "string",
          "const": "register"
        },
        "id": {
          "type": "string"
        },
        "state_ref": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the global states bank."
        },
        "child_ids": {
          "type": "array",
          "description": "Flat ordered list of already-registered child IDs. JS wires these as the mob's submobjects in order. Only present when children are pre-registered for independent animation.",
          "items": { "type": "string" }
        }
      }
    },
    "RemoveCommand": {
      "type": "object",
      "description": "Remove a mobject from the JS scene graph and free it from the registry. Always emitted after FadeOut/Uncreate/Unwrite animations and after ReplacementTransform (removes source).",
      "required": [
        "cmd",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "type": "string",
          "const": "remove"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "RebindCommand": {
      "type": "object",
      "description": "Rebind an existing runtime mobject identity from one id to another.",
      "required": [
        "cmd",
        "source_id",
        "target_id"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "type": "string",
          "const": "rebind"
        },
        "source_id": {
          "type": "string",
          "description": "Current registry id for the runtime object."
        },
        "target_id": {
          "type": "string",
          "description": "New registry id for the same runtime object."
        }
      }
    },
    "AnimateCommand": {
      "type": "object",
      "description": "One scene.play() call. All animations run in parallel by default. The special '#camera' mob_id may appear in animations as a MoveToTarget targeting a CameraState.",
      "required": [
        "cmd",
        "duration",
        "animations"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "type": "string",
          "const": "animate"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "animations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/AnimationDescriptor"
          }
        },
        "updaters": {
          "type": "object",
          "description": "Add 'updaters' (animations running between each frame) for objects from their ids.",
          "additionalProperties": {
            "$ref": "#/definitions/UpdaterDescriptor"
          }
        }
      }
    },
    "UpdaterDescriptor": {
      "type": "object",
      "description": "A scene.play() call driven by object updaters. Captures full scene state at every frame. The special '#camera' key in each frame entry holds a CameraState ref.",
      "required": [
        "cmd",
        "duration",
        "frames"
      ],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "type": "string",
          "const": "updater"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "frames": {
          "type": "array",
          "description": "Per-frame scene state. Each entry maps mob_id (or '#camera') to a state_ref into the global states bank.",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["state_ref"],
              "additionalProperties": false,
              "properties": {
                "state_ref": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "AnimationDescriptor": {
      "oneOf": [
        {
          "$ref": "#/definitions/SimpleAnimation"
        },
        {
          "$ref": "#/definitions/WaitAnimation"
        },
        {
          "$ref": "#/definitions/GroupAnimation"
        },
        {
          "$ref": "#/definitions/TransformAnimation"
        }
      ]
    },
    "WaitAnimation": {
      "type": "object",
      "description": "Wait animation - pauses without operating on any mobject.",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "Wait"
        },
        "rate_func": {
          "$ref": "#/definitions/RateFunc"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Start time in seconds within the animate command window. Default 0."
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "description": "End time in seconds within the animate command window. Default: command duration."
        }
      }
    },
    "SimpleAnimation": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "enum": [
                "Create",
                "Uncreate",
                "Write",
                "Unwrite",
                "FadeIn",
                "FadeOut",
                "Rotate",
                "ScaleInPlace",
                "ShrinkToCenter",
                "GrowFromCenter",
                "GrowFromEdge",
                "GrowArrow",
                "SpinInFromNothing",
                "MoveAlongPath",
                "Indicate",
                "Flash",
                "Circumscribe",
                "Wiggle",
                "ShowPassingFlash",
                "ApplyWave",
                "FocusOn",
                "Pulse",
                "ShowCreationThenDestruction",
                "WiggleOutThenIn",
                "Blink",
                "Rotating",
                "Broadcast"
              ]
            }
          ]
        },
        "id": {
          "type": "string",
          "description": "mob_id of the target mobject."
        },
        "rate_func": {
          "$ref": "#/definitions/RateFunc"
        },
        "params": {
          "$ref": "#/definitions/SimpleAnimationParams"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Start time in seconds within the animate command window. Default 0."
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "description": "End time in seconds within the animate command window. Default: command duration."
        }
      }
    },
    "GroupAnimation": {
      "type": "object",
      "required": [
        "kind",
        "ids"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Swap",
            "CyclicReplace"
          ]
        },
        "ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          },
          "description": "Ordered mob_ids participating in the group animation. For Swap, must be exactly 2. For CyclicReplace, each mobject moves to the next position in order."
        },
        "rate_func": {
          "$ref": "#/definitions/RateFunc"
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path_arc": {
              "type": "number",
              "description": "Arc angle for the movement path in radians. Default is PI/2."
            }
          }
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Start time in seconds within the animate command window. Default 0."
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "description": "End time in seconds within the animate command window. Default: command duration."
        }
      }
    },
    "TransformAnimation": {
      "type": "object",
      "required": [
        "kind",
        "id",
        "state_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "Transform",
            "MoveToTarget"
          ]
        },
        "id": {
          "type": "string",
          "description": "mob_id of the transformed mobject."
        },
        "state_ref": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the global states bank for destination state."
        },
        "rate_func": {
          "$ref": "#/definitions/RateFunc"
        },
        "params": {
          "$ref": "#/definitions/TransformAnimationParams"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "description": "Start time in seconds within the animate command window. Default 0."
        },
        "end": {
          "type": "number",
          "minimum": 0,
          "description": "End time in seconds within the animate command window. Default: command duration."
        }
      }
    },
    "SimpleAnimationParams": {
      "type": "object",
      "description": "Animation-specific parameters for simple animations.",
      "additionalProperties": false,
      "properties": {
        "angle": {
          "type": "number",
          "description": "Rotate: angle in radians."
        },
        "axis": {
          "$ref": "#/definitions/Vec3",
          "description": "Rotate: rotation axis. Defaults to [0,0,1]."
        },
        "scale_factor": {
          "type": "number",
          "description": "ScaleInPlace."
        },
        "about_point": {
          "$ref": "#/definitions/Vec3",
          "description": "Rotation/scale center point."
        },
        "path_id": {
          "type": "string",
          "description": "MoveAlongPath: mob_id of the path VMobject."
        }
      }
    },
    "TransformAnimationParams": {
      "type": "object",
      "description": "Animation-specific parameters for transform animations.",
      "additionalProperties": false,
      "properties": {
        "path_arc": {
          "type": "number",
          "description": "Optional transform path arc in radians."
        },
        "path_arc_axis": {
          "$ref": "#/definitions/Vec3",
          "description": "Optional transform path arc axis."
        }
      }
    },
    "RateFunc": {
      "type": "string",
      "enum": [
        "linear",
        "smooth",
        "rush_into",
        "rush_from",
        "slow_into",
        "there_and_back",
        "wiggle",
        "ease_in_sine",
        "ease_out_sine",
        "ease_in_out_sine",
        "ease_in_quad",
        "ease_out_quad",
        "ease_in_out_quad",
        "ease_in_cubic",
        "ease_out_cubic",
        "ease_in_out_cubic",
        "ease_in_quart",
        "ease_out_quart",
        "ease_in_out_quart",
        "ease_in_quint",
        "ease_out_quint",
        "ease_in_out_quint",
        "ease_in_expo",
        "ease_out_expo",
        "ease_in_out_expo",
        "ease_in_circ",
        "ease_out_circ",
        "ease_in_out_circ",
        "ease_in_back",
        "ease_out_back",
        "ease_in_out_back",
        "ease_in_elastic",
        "ease_out_elastic",
        "ease_in_out_elastic",
        "ease_in_bounce",
        "ease_out_bounce",
        "ease_in_out_bounce"
      ]
    },
    "Vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "[x, y, z]"
    },
    "CameraState": {
      "type": "object",
      "description": "Camera view rectangle stored in the global state bank. Points are 4 corners [UL, UR, DR, DL] of the view plane in world space. focal_distance=0 means orthographic (2D).",
      "required": ["kind", "points"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "const": "Camera"
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 3,
            "maxItems": 3
          },
          "description": "View rectangle corners [UL, UR, DR, DL] in world coordinates."
        },
        "focal_distance": {
          "type": "number",
          "description": "Perspective focal distance. 0 for orthographic / 2D scenes."
        }
      }
    },
    "MoveCameraCommand": {
      "type": "object",
      "description": "Instantaneous camera placement. Applies camera state from the global states bank.",
      "required": ["cmd", "state_ref"],
      "additionalProperties": false,
      "properties": {
        "cmd": {
          "type": "string",
          "const": "move_camera"
        },
        "state_ref": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the global states bank for a CameraState entry."
        }
      }
    },
    "Color": {
      "oneOf": [
        {
          "description": "Transparent / no color.",
          "type": "null"
        },
        {
          "description": "Solid, alpha=1.",
